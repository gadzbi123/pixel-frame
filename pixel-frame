#!/bin/sh
# Control the picture frame. Only `run` stays in the foreground (until Ctrl-C);
# every other command returns straight away, so it is safe to use over SSH.
set -eu

case "${1:-}" in
  start|stop)
    exec systemctl "$1" pixel-frame.service
    ;;
  restart)
    # Stop, then start. A unit installed before the console hand-back was fixed
    # cancels its own `systemctl restart` and stays off; this works with both.
    systemctl stop pixel-frame.service
    exec systemctl start pixel-frame.service
    ;;
  status)
    exec systemctl --no-pager status pixel-frame.service
    ;;
  logs)
    exec journalctl --no-pager -n 50 -u pixel-frame.service
    ;;
  run)
    shift
    script_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
    exec /usr/bin/python3 "$script_dir/pixel_frame.py" "$@"
    ;;
  *)
    echo "Usage: pixel-frame {start|stop|restart|status|logs|run [options]}" >&2
    exit 2
    ;;
esac
